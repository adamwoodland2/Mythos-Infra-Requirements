# /etc/logrotate.d/squid  -  replaces the Debian/Ubuntu default
# CVP requires egress logs retained for at least 30 days; this keeps 45 daily
# archives. Transcript snapshots (/var/cvp/archive) are pruned at 45 days by
# cvp-archive; the lab's own logs are in /etc/logrotate.d/cvp-lab.

/var/log/squid/access.log /var/log/squid/cache.log {
    daily
    rotate 45
    missingok
    notifempty
    compress
    delaycompress
    nocreate
    sharedscripts
    postrotate
        test ! -e /run/squid.pid || /usr/sbin/squid -k rotate
    endscript
}
