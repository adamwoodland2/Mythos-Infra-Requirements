# /etc/logrotate.d/squid  -  replaces the Debian/Ubuntu default
# CVP requires egress logs retained for at least 30 days; this keeps 45 daily
# archives. The transcript drop-box is retained by the same cadence in
# /var/cvp/transcripts (handled by sync-transcripts.sh on the Kali side).

/var/log/squid/access.log /var/log/squid/cache.log {
    daily
    rotate 45
    missingok
    notifempty
    compress
    delaycompress
    nocreate
    sharedscripts
    postrotate
        test ! -e /run/squid.pid || /usr/sbin/squid -k rotate
    endscript
}

/var/log/cvp-mode.log {
    monthly
    rotate 12
    missingok
    notifempty
    compress
}
